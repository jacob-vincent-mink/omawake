{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacob-vincent-mink/omawake/schemas/evaluation-report-v1.schema.json",
  "title": "Omawake accuracy evaluation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation", "application_version", "inputs", "thresholds", "prediction_fingerprint"],
  "properties": {
    "schema_version": { "const": 1 },
    "evaluation": { "const": "omawake-kws-accuracy" },
    "application_version": { "type": "string", "minLength": 1 },
    "inputs": { "$ref": "#/$defs/inputs" },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/threshold" }
    },
    "prediction_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableRate": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "nullableNonnegative": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license_spdx", "source"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "license_spdx": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "config_sha256", "corpus", "matching", "enabled_keyword_ids", "model_name", "model_directory", "keyword_score"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/fingerprint" },
        "config_sha256": { "$ref": "#/$defs/fingerprint" },
        "corpus": { "$ref": "#/$defs/corpus" },
        "matching": {
          "type": "object",
          "additionalProperties": false,
          "required": ["early_tolerance_ms", "late_tolerance_ms"],
          "properties": {
            "early_tolerance_ms": { "type": "integer", "minimum": 0 },
            "late_tolerance_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "enabled_keyword_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "model_name": { "type": "string" },
        "model_directory": { "type": "string" },
        "keyword_score": { "type": "number" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_kind", "requested_runtime", "requested_device", "effective_runtime", "fallback_used", "placement_verified", "placement_evidence"],
      "properties": {
        "backend_kind": { "type": "string" },
        "requested_runtime": { "type": "string" },
        "requested_device": { "type": "string" },
        "effective_runtime": { "type": "string" },
        "fallback_used": { "type": "boolean" },
        "placement_verified": { "type": "boolean" },
        "placement_evidence": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_events", "predictions", "true_positives", "false_positives", "false_negatives", "wrong_id_predictions", "duplicate_predictions", "precision", "recall", "f1", "negative_audio_hours", "false_activations", "false_activations_per_hour"],
      "properties": {
        "expected_events": { "type": "integer", "minimum": 0 },
        "predictions": { "type": "integer", "minimum": 0 },
        "true_positives": { "type": "integer", "minimum": 0 },
        "false_positives": { "type": "integer", "minimum": 0 },
        "false_negatives": { "type": "integer", "minimum": 0 },
        "wrong_id_predictions": { "type": "integer", "minimum": 0 },
        "duplicate_predictions": { "type": "integer", "minimum": 0 },
        "precision": { "$ref": "#/$defs/nullableRate" },
        "recall": { "$ref": "#/$defs/nullableRate" },
        "f1": { "$ref": "#/$defs/nullableRate" },
        "negative_audio_hours": { "type": "number", "minimum": 0 },
        "false_activations": { "type": "integer", "minimum": 0 },
        "false_activations_per_hour": { "$ref": "#/$defs/nullableNonnegative" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "total_audio_milliseconds", "total_elapsed_milliseconds", "aggregate_real_time_factor", "p50_file_milliseconds", "p95_file_milliseconds"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "total_audio_milliseconds": { "type": "number", "minimum": 0 },
        "total_elapsed_milliseconds": { "type": "number", "minimum": 0 },
        "aggregate_real_time_factor": { "$ref": "#/$defs/nullableNonnegative" },
        "p50_file_milliseconds": { "$ref": "#/$defs/nullableNonnegative" },
        "p95_file_milliseconds": { "$ref": "#/$defs/nullableNonnegative" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword_id", "start_ms", "end_ms"],
      "properties": {
        "keyword_id": { "type": "string" },
        "start_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "end_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword_id", "observed_start_ms", "observed_end_ms", "tokens", "timestamps"],
      "properties": {
        "keyword_id": { "type": "string" },
        "observed_start_ms": { "type": "number", "minimum": 0 },
        "observed_end_ms": { "type": "number", "minimum": 0 },
        "tokens": { "type": "array", "items": { "type": "string" } },
        "timestamps": { "type": "array", "items": { "type": "number", "minimum": 0 } }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_index", "prediction_index", "keyword_id", "end_error_ms"],
      "properties": {
        "expected_index": { "type": "integer", "minimum": 0 },
        "prediction_index": { "type": "integer", "minimum": 0 },
        "keyword_id": { "type": "string" },
        "end_error_ms": { "oneOf": [{ "type": "number" }, { "type": "null" }] }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["true_positives", "false_positives", "false_negatives", "wrong_id_predictions", "duplicate_predictions"],
      "properties": {
        "true_positives": { "type": "integer", "minimum": 0 },
        "false_positives": { "type": "integer", "minimum": 0 },
        "false_negatives": { "type": "integer", "minimum": 0 },
        "wrong_id_predictions": { "type": "integer", "minimum": 0 },
        "duplicate_predictions": { "type": "integer", "minimum": 0 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "split", "tags", "audio_duration_milliseconds", "elapsed_milliseconds", "real_time_factor", "expected", "predictions", "matches", "wrong_id_prediction_indices", "duplicate_prediction_indices", "counts"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "split": { "type": "string" },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } },
        "audio_duration_milliseconds": { "type": "number", "minimum": 0 },
        "elapsed_milliseconds": { "type": "number", "minimum": 0 },
        "real_time_factor": { "$ref": "#/$defs/nullableNonnegative" },
        "expected": { "type": "array", "items": { "$ref": "#/$defs/expected" } },
        "predictions": { "type": "array", "items": { "$ref": "#/$defs/prediction" } },
        "matches": { "type": "array", "items": { "$ref": "#/$defs/match" } },
        "wrong_id_prediction_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "duplicate_prediction_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "counts": { "$ref": "#/$defs/counts" }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "model_load_milliseconds", "backend", "files", "summary", "per_keyword", "timing", "prediction_fingerprint"],
      "properties": {
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "model_load_milliseconds": { "type": "number", "minimum": 0 },
        "backend": { "$ref": "#/$defs/backend" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "summary": { "$ref": "#/$defs/metrics" },
        "per_keyword": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metrics" } },
        "timing": { "$ref": "#/$defs/timing" },
        "prediction_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
