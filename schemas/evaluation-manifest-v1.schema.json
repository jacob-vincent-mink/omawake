{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacob-vincent-mink/omawake/schemas/evaluation-manifest-v1.schema.json",
  "title": "Omawake accuracy evaluation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "clips"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license_spdx", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license_spdx": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "early_tolerance_ms": { "type": "integer", "minimum": 0 },
        "late_tolerance_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clip" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword_id"],
      "dependentRequired": {
        "start_ms": ["end_ms"],
        "end_ms": ["start_ms"]
      },
      "properties": {
        "keyword_id": { "type": "string", "minLength": 1 },
        "start_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "end_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "split"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "split": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "expected": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    }
  }
}
