+static bool UseRequestedProvider(const OfflineTtsModelConfig &config,
+                                 const std::string &component) {
+  std::string selected = GetProviderConfigValue(
+      config.provider, "SherpaOnnx.SupertonicComponents");
+  if (selected.empty()) {
+    return true;
+  }
+
+  std::istringstream is(selected);
+  std::string name;
+  while (std::getline(is, name, ',')) {
+    name = Trim(name);
+    if (name == "all" || name == component) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static Ort::SessionOptions GetSupertonicSessionOptions(
+    const OfflineTtsModelConfig &config, const std::string &component) {
+  if (UseRequestedProvider(config, component)) {
+    return GetSessionOptions(config);
+  }
+  return GetSessionOptions(config.num_threads, "cpu");
+}
