+#if ORT_API_VERSION >= 22
+static void AppendRegisteredExecutionProvider(
+    Ort::SessionOptions &session_options, const char *ep_name,
+    std::optional<OrtHardwareDeviceType> hardware_type,
+    std::optional<uint32_t> device_ordinal,
+    const std::unordered_map<std::string, std::string> &options) {
+  auto runtime = AcquireOrtPluginRuntime();
+  runtime->WithEnv([&](Ort::Env &env) {
+    std::vector<Ort::ConstEpDevice> selected_devices;
+    std::ostringstream ep_devices;
+    for (const auto &device : env.GetEpDevices()) {
+      ep_devices << device.EpName() << " (hardware="
+                 << static_cast<int32_t>(device.Device().Type()) << "), ";
+      if (std::strcmp(device.EpName(), ep_name) != 0) continue;
+      if (hardware_type && device.Device().Type() != *hardware_type) continue;
+      if (device_ordinal) {
+        const char *ordinal = device.EpOptions().GetValue("device_id");
+        if (ordinal && ToIntOrDefault(ordinal, -1) !=
+                           static_cast<int32_t>(*device_ordinal)) {
+          continue;
+        }
+      }
+      selected_devices.push_back(device);
+      if (device_ordinal) break;
+    }
+
+    if (selected_devices.empty()) {
+      throw std::runtime_error(std::string(ep_name) +
+                               " is not registered in the retained OrtEnv. EP "
+                               "devices: " +
+                               ep_devices.str());
+    }
+
+    try {
+      session_options.AppendExecutionProvider_V2(env, selected_devices, options);
+    } catch (const std::exception &e) {
+      throw std::runtime_error(std::string("Failed to append registered ") +
+                               ep_name + ": " + e.what() +
+                               ". EP devices: " + ep_devices.str());
+    }
+  });
+}
