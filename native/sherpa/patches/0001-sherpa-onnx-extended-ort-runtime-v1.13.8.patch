+namespace {
+
+thread_local char g_extended_api_error[2048] = {};
+
+void ClearExtendedApiError() noexcept { g_extended_api_error[0] = '\0'; }
+
+void SetExtendedApiError(const char *message) noexcept {
+  std::snprintf(g_extended_api_error, sizeof(g_extended_api_error), "%s",
+                message ? message : "unknown error");
+}
+
+bool UsesRegisteredExecutionProvider(const std::string &provider) {
+  const auto separator = provider.find(':');
+  const std::string name = sherpa_onnx::ToLowerAscii(
+      sherpa_onnx::Trim(provider.substr(0, separator)));
+  return name == "cuda" || name == "openvino";
+}
+
+}  // namespace
+
+int32_t SherpaOnnxGetExtendedApiVersion(void) { return 1; }
+
+struct SherpaOnnxOrtRuntime {
+  std::shared_ptr<sherpa_onnx::OrtPluginRuntime> impl;
+};
+
+SherpaOnnxOrtRuntime *SherpaOnnxCreateOrtRuntime(void) {
+  ClearExtendedApiError();
+  try {
+    auto impl = sherpa_onnx::CreateOrtPluginRuntime();
+    return new SherpaOnnxOrtRuntime{std::move(impl)};
+  } catch (const std::exception &e) {
+    SetExtendedApiError(e.what());
+    return nullptr;
+  } catch (...) {
+    SetExtendedApiError("unknown exception while creating ONNX Runtime environment");
+    return nullptr;
+  }
+}
+
+int32_t SherpaOnnxOrtRuntimeRegisterExecutionProviderLibrary(
+    SherpaOnnxOrtRuntime *runtime, const char *registration_name,
+    const char *library_path) {
+  ClearExtendedApiError();
+  if (!runtime) {
+    SetExtendedApiError("runtime is null");
+    return 0;
+  }
+  if (!registration_name || !*registration_name || !library_path ||
+      !*library_path) {
+    SetExtendedApiError("registration_name and library_path are required");
+    return 0;
+  }
+
+  try {
+    runtime->impl->Register(registration_name, library_path);
+    return 1;
+  } catch (const std::exception &e) {
+    SetExtendedApiError(e.what());
+    return 0;
+  } catch (...) {
+    SetExtendedApiError("unknown exception while registering provider library");
+    return 0;
+  }
+}
+
+int32_t SherpaOnnxOrtRuntimeHasExecutionProviderDevice(
+    SherpaOnnxOrtRuntime *runtime, const char *ep_name,
+    const char *device_type) {
+  ClearExtendedApiError();
+  if (!runtime) {
+    SetExtendedApiError("runtime is null");
+    return 0;
+  }
+  if (!ep_name || !*ep_name) {
+    SetExtendedApiError("ep_name is required");
+    return 0;
+  }
+
+  try {
+    OrtHardwareDeviceType wanted = OrtHardwareDeviceType_CPU;
+    const bool filter_type = device_type && *device_type;
+    if (filter_type) {
+      const std::string type = sherpa_onnx::ToLowerAscii(device_type);
+      if (type == "cpu") {
+        wanted = OrtHardwareDeviceType_CPU;
+      } else if (type == "gpu") {
+        wanted = OrtHardwareDeviceType_GPU;
+      } else if (type == "npu") {
+        wanted = OrtHardwareDeviceType_NPU;
+      } else {
+        SetExtendedApiError("device_type must be cpu, gpu, npu, or empty");
+        return 0;
+      }
+    }
+
+    const bool found = runtime->impl->WithEnv([&](Ort::Env &env) {
+      for (const auto &device : env.GetEpDevices()) {
+        if (std::strcmp(device.EpName(), ep_name) == 0 &&
+            (!filter_type || device.Device().Type() == wanted)) {
+          return true;
+        }
+      }
+      return false;
+    });
+    if (found) return 1;
+    SetExtendedApiError("no matching execution-provider device");
+    return 0;
+  } catch (const std::exception &e) {
+    SetExtendedApiError(e.what());
+    return 0;
+  } catch (...) {
+    SetExtendedApiError("unknown exception while enumerating provider devices");
+    return 0;
+  }
+}
+
+const char *SherpaOnnxOrtRuntimeGetLastError(
+    const SherpaOnnxOrtRuntime *runtime) {
+  (void)runtime;
+  return g_extended_api_error;
+}
+
+void SherpaOnnxDestroyOrtRuntime(SherpaOnnxOrtRuntime *runtime) {
+  if (!runtime) return;
+  delete runtime;
+}
