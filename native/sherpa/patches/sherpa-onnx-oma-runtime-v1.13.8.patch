new file mode 100644
index 0000000..b669c03
--- /dev/null
+++ w/sherpa-onnx/csrc/ort-plugin-runtime.h
@@ -0,0 +1,78 @@
+// sherpa-onnx/csrc/ort-plugin-runtime.h
+// Proof-of-concept process-wide plugin EP registry.
+
+#ifndef SHERPA_ONNX_CSRC_ORT_PLUGIN_RUNTIME_H_
+#define SHERPA_ONNX_CSRC_ORT_PLUGIN_RUNTIME_H_
+
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "onnxruntime_cxx_api.h"  // NOLINT
+#include "sherpa-onnx/csrc/text-utils.h"
+
+namespace sherpa_onnx {
+
+class OrtPluginRuntime {
+ public:
+  OrtPluginRuntime()
+      : env_(ORT_LOGGING_LEVEL_WARNING, "sherpa-onnx-plugin-runtime") {}
+
+  ~OrtPluginRuntime() {
+    // The public C API requires all sherpa engine/session objects to be gone
+    // before the last runtime handle. ORT requires the same teardown order.
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto it = registrations_.rbegin(); it != registrations_.rend(); ++it) {
+      try {
+        env_.UnregisterExecutionProviderLibrary(it->c_str());
+      } catch (...) {
+        // Destructors must not throw across the C boundary.
+      }
+    }
+  }
+
+  OrtPluginRuntime(const OrtPluginRuntime &) = delete;
+  OrtPluginRuntime &operator=(const OrtPluginRuntime &) = delete;
+
+  Ort::Env &Env() { return env_; }
+
+  void Register(const std::string &name, const std::string &path) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    env_.RegisterExecutionProviderLibrary(
+        name.c_str(), SHERPA_ONNX_TO_ORT_PATH(path));
+    registrations_.push_back(name);
+  }
+
+ private:
+  Ort::Env env_;
+  std::mutex mutex_;
+  std::vector<std::string> registrations_;
+};
+
+inline std::mutex g_ort_plugin_runtime_mutex;
+inline std::weak_ptr<OrtPluginRuntime> g_ort_plugin_runtime;
+
+inline std::shared_ptr<OrtPluginRuntime> CreateOrtPluginRuntime() {
+  std::lock_guard<std::mutex> lock(g_ort_plugin_runtime_mutex);
+  if (auto existing = g_ort_plugin_runtime.lock()) return existing;
+  auto runtime = std::make_shared<OrtPluginRuntime>();
+  g_ort_plugin_runtime = runtime;
+  return runtime;
+}
+
+inline std::shared_ptr<OrtPluginRuntime> AcquireOrtPluginRuntime() {
+  std::lock_guard<std::mutex> lock(g_ort_plugin_runtime_mutex);
+  auto runtime = g_ort_plugin_runtime.lock();
+  if (!runtime) {
+    throw std::runtime_error(
+        "no retained sherpa-onnx ORT plugin runtime; create it and register "
+        "the provider library before creating an engine");
+  }
+  return runtime;
+}
+
+}  // namespace sherpa_onnx
+
+#endif  // SHERPA_ONNX_CSRC_ORT_PLUGIN_RUNTIME_H_
