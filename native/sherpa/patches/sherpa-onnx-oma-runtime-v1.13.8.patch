+struct SherpaOnnxOrtRuntime {
+  std::shared_ptr<sherpa_onnx::OrtPluginRuntime> impl;
+  std::string last_error;
+};
+
+SherpaOnnxOrtRuntime *SherpaOnnxCreateOrtRuntime(void) {
+  try {
+    auto impl = sherpa_onnx::CreateOrtPluginRuntime();
+    return new SherpaOnnxOrtRuntime{std::move(impl), {}};
+  } catch (const std::exception &) {
+    return nullptr;
+  }
+}
+
+int32_t SherpaOnnxOrtRuntimeRegisterExecutionProviderLibrary(
+    SherpaOnnxOrtRuntime *runtime, const char *registration_name,
+    const char *library_path) {
+  if (!runtime) return 0;
+  runtime->last_error.clear();
+  if (!registration_name || !*registration_name || !library_path ||
+      !*library_path) {
+    runtime->last_error = "registration_name and library_path are required";
+    return 0;
+  }
+
+  try {
+    runtime->impl->Register(registration_name, library_path);
+    return 1;
+  } catch (const std::exception &e) {
+    runtime->last_error = e.what();
+    return 0;
+  }
+}
+
+int32_t SherpaOnnxOrtRuntimeHasExecutionProviderDevice(
+    SherpaOnnxOrtRuntime *runtime, const char *ep_name,
+    const char *device_type) {
+  if (!runtime) return 0;
+  runtime->last_error.clear();
+  if (!ep_name || !*ep_name) {
+    runtime->last_error = "ep_name is required";
+    return 0;
+  }
+
+  OrtHardwareDeviceType wanted = OrtHardwareDeviceType_CPU;
+  bool filter_type = device_type && *device_type;
+  if (filter_type) {
+    std::string type = sherpa_onnx::ToLowerAscii(device_type);
+    if (type == "cpu") {
+      wanted = OrtHardwareDeviceType_CPU;
+    } else if (type == "gpu") {
+      wanted = OrtHardwareDeviceType_GPU;
+    } else if (type == "npu") {
+      wanted = OrtHardwareDeviceType_NPU;
+    } else {
+      runtime->last_error = "device_type must be cpu, gpu, npu, or empty";
+      return 0;
+    }
+  }
+
+  try {
+    for (const auto &device : runtime->impl->Env().GetEpDevices()) {
+      if (std::strcmp(device.EpName(), ep_name) == 0 &&
+          (!filter_type || device.Device().Type() == wanted)) {
+        return 1;
+      }
+    }
+    runtime->last_error = "no matching execution-provider device";
+    return 0;
+  } catch (const std::exception &e) {
+    runtime->last_error = e.what();
+    return 0;
+  }
+}
+
+const char *SherpaOnnxOrtRuntimeGetLastError(
+    const SherpaOnnxOrtRuntime *runtime) {
+  return runtime ? runtime->last_error.c_str() : "runtime is null";
+}
+
+void SherpaOnnxDestroyOrtRuntime(SherpaOnnxOrtRuntime *runtime) {
+  if (!runtime) return;
+  delete runtime;
+}
